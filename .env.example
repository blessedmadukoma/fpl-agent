# FPL
FPL_ENTRY_ID=
FPL_BASE_URL=
CURRENT_SEASON=
HISTORY_SEASON=

# optional
FPL_DATA_DIR= # where data is stored (default: ./data inside the project)
ODDS_API_KEY=

# DATABASE
POSTGRES_PASSWORD= # <output of: openssl rand -hex 16>   # hex only, so DATABASE_URL does not break

# LLM
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Search
TAVILY_API_KEY=tvly-...

# EVALS
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# false disables Langfuse calls for normal FPL questions; Ollama still runs.
LANGFUSE_TRACING_ENABLED=true
